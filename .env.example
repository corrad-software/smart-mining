# Copy to .env for local Docker Compose, or paste these into Coolify.
# Local defaults also live in docker-compose.yml, so a copy is only required
# when you override them.

# Public URL of the Laravel container (API + Filament /admin). No trailing slash.
# Coolify example: http://SERVER:41808
APP_URL=http://localhost:41808

# Browser-facing API base, including /api. Read when the web container starts.
# Coolify example: http://SERVER:41808/api
VITE_API_URL=http://localhost:41808/api

# Origin of the Vue app. Comma-separated, no paths.
# Coolify example: http://SERVER:41880
CORS_ALLOWED_ORIGINS=http://localhost:41880,http://127.0.0.1:41880

# Leave empty to generate a key on first API start and keep it in the api-storage volume.
# Set a real key before production: php artisan key:generate --show
APP_KEY=

APP_NAME="Smart Mining"
APP_DEBUG=false
LOG_LEVEL=info

DB_DATABASE=smart_mining
DB_USERNAME=smart_mining
DB_PASSWORD=smartmining

# Host ports published by docker compose. Open these two in the AWS security group.
# Leave PostgreSQL unpublished.
WEB_PORT=41880
API_PORT=41808
